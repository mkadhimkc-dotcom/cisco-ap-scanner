{
  "name": "label-scanner",
  "version": "2.0.0",
  "private": true,
  "description": "Static phone web app that reads Cisco switch and Cisco/Meraki AP label barcodes and exports CSV.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test \"test/unit/*.test.mjs\" \"test/golden/*.test.mjs\"",
    "test:unit": "node --test \"test/unit/*.test.mjs\"",
    "test:golden": "node --test \"test/golden/*.test.mjs\"",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/make-fixtures.mjs",
    "fixtures:video": "node scripts/make-y4m.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@playwright/test": "1.56.1",
    "bwip-js": "4.11.4",
    "jpeg-js": "0.4.4",
    "zxing-wasm": "2.2.4"
  }
}
